{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/view/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron",
      "destination": "/api/cron.py"
    },
    {
      "source": "/api/snapshot",
      "destination": "/api/snapshot.py"
    },
    {
      "source": "/api/blob",
      "destination": "/api/blob.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 10 * * 5"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,outputs/**,.venv/**,view/**,**/*.test.py,**/test_*.py}"
    },
    "api/blob.js": {
      "maxDuration": 30
    }
  }
}
