# PostgreSQL
# Set DATABASE_URL or use the individual POSTGRES_* fields below.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=produtividade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=
PGSSLROOTCERT=

# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=replace-with-a-new-token
JIRA_SQUAD_FIELD=customfield_10431
JIRA_SPRINT_FIELD=customfield_10010
JIRA_CROSSING_FIELD=customfield_10894

# Clockify
CLOCKIFY_API_KEY=replace-with-a-new-key
CLOCKIFY_WORKSPACE_ID=replace-with-workspace-id
# Re-read recent days so approved edits are reflected in the warehouse.
CLOCKIFY_INCREMENTAL_LOOKBACK_DAYS=10

# Flow
# Prefer Login credentials so the ETL renews the JWT automatically in memory.
FLOW_BASE_URL=https://zgsolucoes.flow.gp/Metadados.Api
FLOW_LOGIN_URL=https://zgsolucoes.flow.gp/metadados.api/api/v1/Login
FLOW_LOGIN_USERNAME=
FLOW_LOGIN_PASSWORD=
# Optional emergency fallback. Do not set this when Login credentials are available.
FLOW_API_TOKEN=
FLOW_TOKEN_REFRESH_SKEW_SECONDS=300
FLOW_ENABLED=false
# Keep true when the Login user can read employee identities. Set false only
# for points-only recovery using previously persisted Flow person IDs.
FLOW_IDENTITY_SYNC_ENABLED=true
# When true, request points for every active stored Flow person, even without
# a Clockify mapping. Keep false for the normal mapped-only operation.
FLOW_POINTS_INCLUDE_UNMAPPED=false

# Daily Flow point × Clockify reconciliation.
HOURS_COMPETENCE_CLOSING_DAY=25
HOURS_RECONCILIATION_LOOKBACK_DAYS=45
HOURS_RECONCILIATION_TOLERANCE_MINUTES=15
# Business exceptions remain auditable but do not generate alerts.
FLOW_RECONCILIATION_IGNORED_PERSON_IDS=208

# Optional cron monitoring (for example, a Healthchecks.io ping URL).
# Keep this URL secret and leave it empty until the check is created.
ETL_HEALTHCHECK_URL=
ETL_RETRIES=1
ETL_RETRY_DELAY=30

# Keep true for the current single-host EC2 deployment. In corporate
# environments, run `python -m operationalization migrate` as a separate job
# and set this to false for the regular ETL job.
ETL_AUTO_MIGRATE=true
