# Jira
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=replace-with-a-new-token
JIRA_ESTIMATE_FIELD=timeoriginalestimate

# Clockify
CLOCKIFY_API_KEY=replace-with-a-new-key
CLOCKIFY_WORKSPACE_ID=replace-with-workspace-id
CLOCKIFY_PAGE_SIZE=1000

# Vercel
# New Vercel Blob connections use OIDC automatically. Only set this for a
# legacy Blob store that provides a long-lived read-write token.
# BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
# Optional for local testing; in Vercel the gateway URL is derived from the
# current request host.
# BLOB_GATEWAY_URL=https://your-project.vercel.app/api/blob
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters

# OKR metric conventions
OKR_YEAR=2026
OKR_TIMEZONE=America/Sao_Paulo
# Optional override. Leave unset to use today's execution date as the upper bound.
# OKR_BUGS_JQL=
