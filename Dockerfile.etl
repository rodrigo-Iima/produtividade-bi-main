FROM python:3.12-slim

ARG APP_UID=10001
ARG APP_GID=10001
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="produtividade-etl" \
      org.opencontainers.image.description="ETL Jira/Clockify para PostgreSQL" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --gid "${APP_GID}" app \
    && useradd --uid "${APP_UID}" --gid app --home-dir /app \
        --no-create-home --shell /usr/sbin/nologin app \
    && chown app:app /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=app:app . .

USER app

ENTRYPOINT ["python", "-m", "operationalization"]
CMD ["run"]
