# Copy to deploy/local/.env. Never commit the filled file.
LOCAL_POSTGRES_DB=produtividade_local
LOCAL_POSTGRES_PORT=55432
LOCAL_POSTGRES_BIND_ADDRESS=127.0.0.1

LOCAL_POSTGRES_MIGRATOR_USER=produtividade_migrator
LOCAL_POSTGRES_MIGRATOR_PASSWORD=replace-with-local-migrator-password
LOCAL_POSTGRES_ETL_PASSWORD=replace-with-local-etl-password
LOCAL_POSTGRES_READER_PASSWORD=replace-with-local-reader-password

# Runtime ETL settings are loaded by the migrate/etl services.
LOCAL_RUNTIME_ENV_FILE=runtime.env
