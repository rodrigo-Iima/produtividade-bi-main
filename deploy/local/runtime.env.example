# Copy to deploy/local/runtime.env and fill only the source credentials needed
# for the local run. This file is loaded by the ETL and migration services.
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=replace-with-email
JIRA_TOKEN=replace-with-secret
JIRA_EPIC_LINK_FIELD=customfield_10014
JIRA_PLANNED_START_FIELD=customfield_11167
JIRA_HTTP_TIMEOUT_SECONDS=30
JIRA_MAX_RETRIES=3
JIRA_RETRY_BACKOFF_SECONDS=1
JIRA_PAGE_SIZE=100

CLOCKIFY_API_KEY=replace-with-secret
CLOCKIFY_WORKSPACE_ID=replace-with-workspace-id
CLOCKIFY_INCREMENTAL_LOOKBACK_DAYS=10

FLOW_BASE_URL=https://zgsolucoes.flow.gp/Metadados.Api
FLOW_LOGIN_URL=https://zgsolucoes.flow.gp/metadados.api/api/v1/Login
FLOW_LOGIN_USERNAME=replace-with-secret
FLOW_LOGIN_PASSWORD=replace-with-secret
FLOW_API_TOKEN=
FLOW_ENABLED=false
FLOW_IDENTITY_SYNC_ENABLED=true
FLOW_POINTS_INCLUDE_UNMAPPED=false

ETL_RETRIES=1
ETL_RETRY_DELAY=30
ETL_HEALTHCHECK_URL=
ETL_LOG_RETENTION_DAYS=30
