# PostgreSQL must be reachable from the container over the provider's private
# network. Keep the real file outside Git or inject these values from a secret
# manager.
DATABASE_URL=postgresql://user:password@postgres.internal:5432/produtividade
POSTGRES_SSLMODE=require

JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_TOKEN=replace-with-secret
JIRA_SQUAD_FIELD=customfield_10431
JIRA_SPRINT_FIELD=customfield_10010
JIRA_CROSSING_FIELD=customfield_10894

CLOCKIFY_API_KEY=replace-with-secret
CLOCKIFY_WORKSPACE_ID=replace-with-workspace-id
CLOCKIFY_INCREMENTAL_LOOKBACK_DAYS=10

FLOW_BASE_URL=https://zgsolucoes.flow.gp/Metadados.Api
FLOW_API_TOKEN=replace-with-secret
FLOW_ENABLED=false
HOURS_COMPETENCE_CLOSING_DAY=25
HOURS_RECONCILIATION_LOOKBACK_DAYS=45
HOURS_RECONCILIATION_TOLERANCE_MINUTES=15
FLOW_RECONCILIATION_IGNORED_PERSON_IDS=208

ETL_AUTO_MIGRATE=false
ETL_RETRIES=1
ETL_RETRY_DELAY=30
ETL_HEALTHCHECK_URL=
