POSTGRES_DB=produtividade
POSTGRES_USER=produtividade
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Keep 127.0.0.1 unless direct external access is explicitly required.
# When using 0.0.0.0, prefer approved /32 addresses in the provider firewall.
# If the provider rule uses 0.0.0.0/0, pg_hba.conf must limit external logins
# to the least-privilege produtividade_reader role.
POSTGRES_BIND_ADDRESS=127.0.0.1

METABASE_IMAGE=metabase/metabase:v0.62.5.x
JAVA_TIMEZONE=America/Sao_Paulo
JAVA_OPTS=-Xms256m -Xmx1280m
